{
  "id": "sms-inbox-bridge",
  "name": "SMS Inbox Bridge",
  "description": "Bind one phone number to one OpenClaw session and mirror that session over SMS.",
  "contracts": {
    "tools": ["human_alert"]
  },
  "activation": {
    "onStartup": true
  },
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "binding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionKey": {
            "type": "string",
            "description": "Bound parent session key. Defaults to agent:main:main."
          },
          "phoneNumber": {
            "type": "string",
            "description": "Trusted human phone number that owns the inbox."
          }
        }
      },
      "transport": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["android-gateway"]
          },
          "serverMode": {
            "type": "string",
            "enum": ["cloud", "local"],
            "description": "Android SMS Gateway server mode. Use local for USB-tunneled Local Server."
          },
          "apiBaseUrl": {
            "type": "string",
            "description": "SMS Gateway API base URL, e.g. https://api.sms-gate.app/3rdparty/v1 or http://127.0.0.1:18080."
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "webhookPath": {
            "type": "string",
            "description": "Gateway route path that receives sms:received webhooks."
          },
          "webhookSigningKey": {
            "type": "string",
            "description": "HMAC signing key configured in the Android app for Cloud Server mode."
          },
          "deviceId": {
            "type": "string"
          },
          "simNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "sendPriority": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127
          },
          "ttlSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "deviceActiveWithinHours": {
            "type": "integer",
            "minimum": 0
          },
          "skipPhoneValidation": {
            "type": "boolean"
          }
        }
      },
      "inboundRecovery": {
        "type": "object",
        "additionalProperties": false,
        "description": "Optional Local Server inbox export polling for recovering missed inbound SMS.",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "catchUpOnStart": {
            "type": "boolean",
            "description": "When true, export the configured lookback window on plugin startup. Leave false to avoid replaying old messages after gateway restarts."
          },
          "pollIntervalMs": {
            "type": "integer",
            "minimum": 5000,
            "maximum": 3600000
          },
          "lookbackMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "safetyLagMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        }
      },
      "alert": {
        "type": "object",
        "additionalProperties": false,
        "description": "Optional guarded agent-facing human alert tool.",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "sms": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "maxChars": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          },
          "call": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mode": {
                "type": "string",
                "enum": ["disabled", "dry-run", "local-http"]
              },
              "endpointUrl": {
                "type": "string",
                "description": "Local helper endpoint for call alerts. The plugin posts only reason metadata; the helper owns the phone number."
              },
              "bearerToken": {
                "type": "string"
              },
              "ringSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          }
        }
      },
      "outbound": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxSegmentChars": {
            "type": "integer",
            "minimum": 60,
            "maximum": 1000
          },
          "maxSegmentsPerReply": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "tester": {
        "type": "object",
        "additionalProperties": false,
        "description": "Optional local Twilio tester lane for exercising the Android webhook path without manual SMS input.",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "routePath": {
            "type": "string",
            "description": "Local route that asks Twilio to send a test SMS into the Android phone."
          },
          "sessionKey": {
            "type": "string",
            "description": "Separate bound session key for Twilio-originated test messages."
          },
          "phoneNumber": {
            "type": "string",
            "description": "Twilio phone number accepted as the tester sender and used as the reply target."
          },
          "sharedSecret": {
            "type": "string",
            "description": "Secret required in x-sms-bridge-tester-secret when calling the tester route."
          },
          "twilio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accountSid": {
                "type": "string"
              },
              "authToken": {
                "type": "string"
              },
              "fromNumber": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
